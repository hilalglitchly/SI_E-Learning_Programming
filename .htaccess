# Disable directory listing
Options -Indexes

# Block dotfiles (.env, .htaccess, .gitignore, .git)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block sensitive root project/doc/SQL/config files if webroot mistakenly points here
<FilesMatch "(?i)\.(sql|md|pdf|html|lock|json|xml|py|yml|yaml|bak|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block internal directories and route all HTTP requests to public/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|app|bootstrap|config|database|docs|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
